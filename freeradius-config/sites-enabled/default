server default {

listen {
    type = auth
    ipaddr = *
    port = 0
    limit {
          max_connections = 16
          lifetime = 0
          idle_timeout = 30
    }
}

listen {
    ipaddr = *
    port = 0
    type = acct
    limit {
    }
}

listen {
    type = auth
    ipv6addr = ::
    port = 0
    limit {
          max_connections = 16
          lifetime = 0
          idle_timeout = 30
    }
}

listen {
    ipv6addr = ::
    port = 0
    type = acct
    limit {
    }
}

authorize {
    # Skip jika IPoE (MAC auth dari DHCP - Called-Station-Id mengandung "dhcp")
    if ("%{Called-Station-Id}" =~ /^dhcp/i) {
        reject
    }
    # Skip jika username berformat MAC address (IPoE)
    if ("%{User-Name}" =~ /^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$/) {
        reject
    }

    # Reject jika user masuk grup non-PPPoE (Mencegah salah auth di port PPPoE)
    # PENGECUALIAN: Izinkan jika nama NAS client mengandung kata "olt" (case-insensitive)
    if ("%{sql:SELECT groupname FROM radusergroup WHERE username = '%{User-Name}' AND groupname IN ('vpn', 'wireless', 'ipoe', '8021x', 'mikrotik-full', 'mikrotik-write', 'mikrotik-read') LIMIT 1}" != "") {
        if (!("%{client:shortname}" =~ /olt/i)) {
            reject
        }
    }

    filter_username
    preprocess
    chap
    mschap
    digest
    suffix
    eap {
        ok = return
    }
    files
    sql
    # Enforce global simultaneous use limit of 1 if not specified in radcheck
    if (!control:Simultaneous-Use) {
        update control {
            Simultaneous-Use := 1
        }
    }
    -ldap
    expiration
    logintime
    pap
}

authenticate {
    Auth-Type PAP {
        pap
    }
    Auth-Type CHAP {
        chap
    }
    Auth-Type MS-CHAP {
        mschap
    }
    mschap
    digest
    eap
}

preacct {
    preprocess
    acct_unique
    suffix
    files
}

accounting {
    unix
    sql
    exec
    attr_filter.accounting_response
}

session {
    sql
}

post-auth {
    sql

    # Kirim attribute privilege OLT jika login dari perangkat OLT (Shortname mengandung 'olt')
    if ("%{client:shortname}" =~ /olt/i) {
        if ("%{sql:SELECT groupname FROM radusergroup WHERE username = '%{User-Name}' AND groupname = 'mikrotik-full' LIMIT 1}" == "mikrotik-full") {
            update reply {
                Service-Type := Administrative-User
                Cisco-AVPair := "shell:priv-lvl=15"
                Mikrotik-Group := "full"
            }
        }
        elsif ("%{sql:SELECT groupname FROM radusergroup WHERE username = '%{User-Name}' AND groupname = 'mikrotik-write' LIMIT 1}" == "mikrotik-write") {
            update reply {
                Service-Type := NAS-Prompt-User
                Cisco-AVPair := "shell:priv-lvl=7"
                Mikrotik-Group := "write"
            }
        }
        elsif ("%{sql:SELECT groupname FROM radusergroup WHERE username = '%{User-Name}' AND groupname = 'mikrotik-read' LIMIT 1}" == "mikrotik-read") {
            update reply {
                Service-Type := NAS-Prompt-User
                Cisco-AVPair := "shell:priv-lvl=1"
                Mikrotik-Group := "read"
            }
        }
    }


    if (session-state:User-Name && reply:User-Name && request:User-Name && (reply:User-Name == request:User-Name)) {
        update reply {
            &User-Name !* ANY
        }
    }
    update {
        &reply: += &session-state:
    }

    remove_reply_message_if_eap

    Post-Auth-Type REJECT {
        sql
        attr_filter.access_reject
        eap
        remove_reply_message_if_eap
    }

    Post-Auth-Type Challenge {
    }
}

pre-proxy {
}

post-proxy {
    eap
}

}
