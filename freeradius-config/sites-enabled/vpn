server vpn {

listen {
    type = auth
    ipaddr = *
    port = 31812
    limit {
          max_connections = 16
          lifetime = 0
          idle_timeout = 30
    }
}

listen {
    ipaddr = *
    port = 31813
    type = acct
    limit {
    }
}

authorize {
    # Hanya izinkan jika user memiliki grup 'vpn' di database radusergroup
    if ("%{sql:SELECT groupname FROM radusergroup WHERE username = '%{User-Name}' AND groupname = 'vpn' LIMIT 1}" != "vpn") {
        reject
    }

    filter_username
    preprocess
    chap
    mschap
    digest
    suffix
    eap {
        ok = return
    }
    files
    sql
    pap
}

authenticate {
    Auth-Type PAP {
        pap
    }
    Auth-Type CHAP {
        chap
    }
    Auth-Type MS-CHAP {
        mschap
    }
    mschap
    digest
    eap
}

preacct {
    preprocess
    acct_unique
    suffix
    files
}

accounting {
    sql
    attr_filter.accounting_response
}

session {
    sql
}

post-auth {
    sql

    # If these attributes are not set in the reply, fetch them from PostgreSQL.
    # This ensures that EAP clients (where authorize sql is skipped in the final round)
    # get their assigned attributes.
    if (!reply:Framed-IP-Address) {
        if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Framed-IP-Address' LIMIT 1}" != "") {
            update reply {
                Framed-IP-Address := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Framed-IP-Address' LIMIT 1}"
            }
        }
    }
    if (!reply:Framed-Pool) {
        if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Framed-Pool' LIMIT 1}" != "") {
            update reply {
                Framed-Pool := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Framed-Pool' LIMIT 1}"
            }
        }
    }
    if (!reply:Mikrotik-Rate-Limit) {
        if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Mikrotik-Rate-Limit' LIMIT 1}" != "") {
            update reply {
                Mikrotik-Rate-Limit := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Mikrotik-Rate-Limit' LIMIT 1}"
            }
        }
    }

    Post-Auth-Type REJECT {
        sql
        attr_filter.access_reject
    }
}

}
