def api_mfa_setup():
    try:
        secret = pyotp.random_base32()
        user = execute_query("SELECT username FROM admin_users WHERE id = %s", (session['user_id'],))[0]
        provisioning_url = pyotp.totp.TOTP(secret).provisioning_uri(
