def background_nas_monitor():
    """Memantau status ping ke setiap IP NAS setiap 1 menit dan mengirim notifikasi Telegram jika berubah."""
    print("[nas-monitor] Thread initialized, sleeping 15s for stability...")
    socketio.sleep(15) # Tunggu 15 detik saat startup agar koneksi stabil
    print("[nas-monitor] Thread starting active monitoring...")
    while True:
        try:
            nas_list = execute_query("SELECT nasname, shortname FROM nas")
            for nas in (nas_list or []):
                nas_ip = nas['nasname']
                nas_name = nas['shortname'] or nas_ip
                
                # Gunakan fungsi ping_nas yang lebih tangguh (ping + port check)
                is_online = (ping_nas(nas_ip) == "online")
                
                prev_status = _nas_last_status.get(nas_ip)
                if prev_status is not None:
                    # Jika status berubah dari ONLINE ke OFFLINE
                    if prev_status and not is_online:
                        time_str = datetime.now().strftime('%H:%M')
                        
                        # Hitung estimasi pelanggan PPPoE/IPoE yang terputus dari radacct aktif
                        affected_res = execute_query("""
                            SELECT COUNT(DISTINCT username) as count FROM radacct 
                            WHERE nasipaddress = %s AND acctstoptime IS NULL
                        """, (nas_ip,))
                        affected_count = affected_res[0]['count'] if affected_res else 0
                        
                        msg = (
                            f"⚠️ <b>[ALERT]</b> NAS \"<b>{nas_name}</b>\" (<code>{nas_ip}</code>) terdeteksi <b>OFFLINE</b> pada <b>{time_str} WIB</b>.\n\n"
                            f"🚨 <b>Estimasi Dampak:</b> Sekitar <b>{affected_count} pelanggan</b> terputus koneksinya.\n"
                            f"Mohon segera periksa perangkat atau koneksi uplink!"
                        )
                        reply_markup = {
                            "inline_keyboard": [
                                [
                                    {"text": "⚡ Cek Ping Ulang", "callback_data": f"ping_nas:{nas_ip}"},
                                    {"text": "🖥️ Buka Web Dashboard", "url": "https://radius.access.daragroup.cloud/nas"}
                                ]
                            ]
                        }
                        send_telegram_notification(msg, reply_markup=reply_markup)
                        _nas_last_status[nas_ip] = False
                    # Jika status berubah dari OFFLINE ke ONLINE
                    elif not prev_status and is_online:
                        msg = f"✅ <b>[RESOLVED]</b> NAS \"<b>{nas_name}</b>\" (<code>{nas_ip}</code>) kembali <b>ONLINE</b>."
                        send_telegram_notification(msg)
                        _nas_last_status[nas_ip] = True
                else:
                    # Inisialisasi awal
                    _nas_last_status[nas_ip] = is_online
        except Exception as e:
            print(f"[nas-monitor] Error: {e}")
            
        socketio.sleep(60)

def background_telegram_bot():
    """Mendengar pesan Telegram masuk (bot polling) untuk melayani perintah teknisi secara interaktif."""
    print("[telegram-bot] Thread initialized, sleeping 20s for stability...")
    socketio.sleep(20) # Tunggu agar startup stabil
    print("[telegram-bot] Thread starting active polling...")
    offset = 0
    
    while True:
        try:
            # Muat token Telegram
            token = app.config.get('TELEGRAM_BOT_TOKEN')
            if not token:
                env_path = '/app/.telegram.env'
                if os.path.exists(env_path):
                    with open(env_path) as f:
                        for line in f:
                            if line.startswith('TELEGRAM_BOT_TOKEN='):
                                token = line.split('=', 1)[1].strip()
                                app.config['TELEGRAM_BOT_TOKEN'] = token
                                break
            
            if not token:
                print("[telegram-bot] Warning: TELEGRAM_BOT_TOKEN not found!")
                socketio.sleep(10)
                continue
                
            # Long polling updates dari Telegram API
            url = f"https://api.telegram.org/bot{token}/getUpdates"
            params = {'offset': offset, 'timeout': 15}
            print(f"[telegram-bot] Polling updates with offset={offset}...")
            resp = requests.get(url, params=params, timeout=20)
            if resp.status_code != 200:
                socketio.sleep(5)
                continue
                
            updates = resp.json().get('result', [])
            for update in updates:
                offset = update['update_id'] + 1
                
                # Memproses Interaksi Tombol Callback Query
                if 'callback_query' in update:
                    cb = update['callback_query']
                    cb_id = cb.get('id')
                    cb_data = cb.get('data', '')
                    cb_chat_id = cb.get('message', {}).get('chat', {}).get('id')
                    
                    try:
                        requests.post(f"https://api.telegram.org/bot{token}/answerCallbackQuery", data={
                            'callback_query_id': cb_id
                        }, timeout=3)
                    except:
                        pass
                        
                    if cb_data and cb_chat_id:
                        if cb_data.startswith('ping_nas:'):
                            nas_ip = cb_data.split(':', 1)[1]
                            requests.post(f"https://api.telegram.org/bot{token}/sendMessage", data={
                                'chat_id': cb_chat_id,
                                'text': f"⚡ Sedang menguji ping ulang ke IP <code>{nas_ip}</code>...",
                                'parse_mode': 'HTML'
                            }, timeout=5)
                            
                            status = ping_nas(nas_ip)
                            status_emoji = "🟢 ONLINE" if status == "online" else "🔴 OFFLINE"
                            requests.post(f"https://api.telegram.org/bot{token}/sendMessage", data={
                                'chat_id': cb_chat_id,
